DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_db_password
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
# Must be Base64 (at least 32 bytes), e.g. generate with: openssl rand -base64 48
JWT_KEY=your_base64_jwt_secret
GOOGLE_OAUTH2_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH2_CLIENT_SECRET=your_google_client_secret
STRIPE_SECRET=sk_test_your_stripe_secret
FILE_ZONE=your_storage_zone
CDN_KEY=your_cdn_api_key
CDN_HOST=your_cdn_host
DB_PORT=5432
DB_NAME=shopverse
FRONTEND_URL=http://localhost:3000
# Store owner: this account gets admin access
ADMIN_EMAIL=you@example.com
# Load the starter catalog into an empty database
SEED_DATA=true
# Set to false if you have no mail server configured
EMAIL_VERIFICATION=true
